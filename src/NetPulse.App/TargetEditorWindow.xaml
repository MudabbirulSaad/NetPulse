<Window x:Class="NetPulse.App.TargetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetPulse Target"
        Width="570"
        Height="690"
        MinHeight="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource InkBrush}">
    <Window.Resources>
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Background" Value="#0D161A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#476E5D" />
        </Style>

        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Background" Value="#0D161A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Height="38"
                                          Padding="11,0"
                                          HorizontalContentAlignment="Stretch"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleChrome"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleChrome" Property="Background" Value="#142127" />
                                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#3A555E" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleChrome" Property="Background" Value="#172A30" />
                                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                    <Path Grid.Column="1"
                                          Width="8"
                                          Height="5"
                                          Margin="12,0,1,0"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource MutedTextBrush}"
                                          Data="M 0 0 L 8 0 L 4 5 Z" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,3,0,0"
                                        Padding="3"
                                        Background="{StaticResource RaisedBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF8A8A" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility"
                    Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringVisibility}}" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource GridTexture}">
        <Border Margin="22"
                Padding="22"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Style="{StaticResource EyebrowText}" Text="TARGET CONFIGURATION" />
                    <TextBlock Margin="0,4,0,0"
                               FontFamily="Bahnschrift SemiCondensed"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Text="{Binding DialogTitle}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Use a reachable service you are permitted to monitor." />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="DISPLAY NAME" />
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="60"
                                 AutomationProperties.Name="Target display name" />
                        <TextBlock Style="{StaticResource FieldError}" Text="{Binding NameError}" />

                        <TextBlock Margin="0,15,0,0"
                                   Style="{StaticResource EyebrowText}"
                                   Text="CHECK TYPE" />
                        <ComboBox ItemsSource="{Binding TargetTypes}"
                                  SelectedItem="{Binding TargetType}"
                                  Style="{StaticResource InputComboBox}"
                                  AutomationProperties.Name="Target check type" />

                        <TextBlock Margin="0,15,0,0"
                                   Style="{StaticResource EyebrowText}"
                                   Text="{Binding AddressLabel}" />
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding AddressHint}"
                                 AutomationProperties.Name="Target address" />
                        <TextBlock Style="{StaticResource FieldError}" Text="{Binding AddressError}" />

                        <StackPanel Margin="0,15,0,0"
                                    Visibility="{Binding IsDns, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Style="{StaticResource EyebrowText}" Text="DNS RESOLVER IP" />
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding DnsResolver, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="DNS resolver IP address" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding ResolverError}" />
                        </StackPanel>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowText}" Text="POLL INTERVAL" />
                                <ComboBox ItemsSource="{Binding PollIntervals}"
                                          SelectedItem="{Binding PollIntervalSeconds}"
                                          Style="{StaticResource InputComboBox}"
                                          AutomationProperties.Name="Poll interval in seconds" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource EyebrowText}" Text="TIMEOUT SECONDS" />
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Timeout in seconds" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldError}" Text="{Binding TimingError}" />

                        <CheckBox Margin="0,16,0,0"
                                  IsChecked="{Binding IsEnabled}"
                                  Foreground="{StaticResource TextBrush}"
                                  Content="Enable recurring monitoring"
                                  AutomationProperties.Name="Enable recurring monitoring" />
                        <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralError}" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Margin="0,17,0,17"
                        Padding="12,10"
                        Background="#0D161A"
                        BorderBrush="{Binding TestState, Converter={StaticResource HealthBrush}}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Width="24"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{Binding TestState, Converter={StaticResource HealthBrush}}"
                                   Text="{Binding TestState, Converter={StaticResource HealthGlyph}}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding TestStatus}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding TestConnectionCommand}"
                            Content="TEST CONNECTION"
                            Style="{StaticResource QuietButton}"
                            AutomationProperties.Name="Test target connection" />
                    <Button Grid.Column="2"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Content="CANCEL"
                            Style="{StaticResource QuietButton}" />
                    <Button x:Name="SaveButton"
                            Grid.Column="3"
                            Click="OnSaveClick"
                            IsDefault="True"
                            Content="SAVE TARGET"
                            Style="{StaticResource AccentButton}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
